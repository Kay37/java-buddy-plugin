<idea-plugin>
    <id>dev.javabuddy</id>
    <name>Java Buddy</name>
    <!-- Filled in from pom.xml at build time. -->
    <version>${project.version}</version>
    <vendor>Java Buddy</vendor>

    <description><![CDATA[
        A friendly helper for people learning Java: explains errors and crashes in plain English,
        right under the code, with how to fix them and a small example. Rest the mouse on a Java word
        like static or extends for a short card that explains it. Practice with small drills that check
        your code and tell you what to fix. Get tips on how your code is written from the Coach, and
        earn XP in Java Quest, a small game of coding quests.
    ]]></description>

    <!-- Built and tested against IntelliJ 2026.2 (build 262). -->
    <idea-version since-build="262"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Java Buddy"
                    anchor="right"
                    icon="AllIcons.Actions.IntentionBulb"
                    factoryClass="dev.javabuddy.JavaBuddyToolWindowFactory"/>
        <notificationGroup id="Java Buddy" displayType="BALLOON"/>
        <postStartupActivity implementation="dev.javabuddy.JavaBuddyStartup"/>
        <editorNotificationProvider implementation="dev.javabuddy.drills.DrillNotificationProvider"/>
        <editorNotificationProvider implementation="dev.javabuddy.quest.QuestNotificationProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA" implementationClass="dev.javabuddy.quest.QuestLineMarkerProvider"/>
        <localInspection language="JAVA"
                         shortName="JavaBuddyStyleCoach"
                         displayName="Style Coach tips"
                         groupName="Java Buddy"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="dev.javabuddy.coach.StyleCoachInspection"/>
    </extensions>

    <projectListeners>
        <listener class="dev.javabuddy.errors.CrashWatcher"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>

    <actions>
        <!-- Editor right-click menu: at the top, so it's easy to find. -->
        <action id="JavaBuddy.AskCoach"
                class="dev.javabuddy.quest.AskCoachAction"
                text="Ask the AI Coach"
                description="Ask about this file or the lines you selected. The coach asks and points; it never writes your code."
                icon="AllIcons.Actions.IntentionBulb">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <group id="JavaBuddy.Options" text="Java Buddy" popup="true">
            <action id="JavaBuddy.ToggleErrorBubbles"
                    class="dev.javabuddy.ToggleErrorBubblesAction"
                    text="Explain Errors Under the Code"
                    description="Show a plain-English bubble under each line with a red error"/>
            <action id="JavaBuddy.ToggleConceptHover"
                    class="dev.javabuddy.ToggleConceptHoverAction"
                    text="Explain Java Words When Hovering"
                    description="Show a short card when the mouse rests on a Java word like static or extends"/>
            <action id="JavaBuddy.ToggleStyleCoach"
                    class="dev.javabuddy.ToggleStyleCoachAction"
                    text="Style Coach Tips"
                    description="Check how your code is written: notes in the Coach tab and dotted tips under the code. Turn off to stop it running."/>
            <action id="JavaBuddy.ToggleCrashPopups"
                    class="dev.javabuddy.ToggleCrashPopupsAction"
                    text="Explain Crashes When a Program Stops"
                    description="Pop up a plain-English explanation when a run ends with an exception"/>
            <action id="JavaBuddy.ToggleTodayNote"
                    class="dev.javabuddy.ToggleTodayNoteAction"
                    text="Suggest Today's Quest Each Day"
                    description="Once a day, when a project opens, suggest one small quest (about 10 minutes)"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
        <action id="JavaBuddy.OpenDashboard"
                class="dev.javabuddy.dashboard.OpenDashboardAction"
                text="Open Java Coach Dashboard"
                description="Open your quests, stars and badges in the browser">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
